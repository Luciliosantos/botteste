        }

        // === GERAR PIX DO PLANO — CORRIGIDO ===
        if(substr($cb, 0, 7) === 'plano_'){
            $chave = (int)substr($cb, 7);
            if(!isset($planos_ssh[$chave])) {
                responder_clique($callback_id, "Plano inválido!");
                editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>'❌ Plano inválido!','parse_mode'=>'html']);
                continue;
            }
            $pl = $planos_ssh[$chave];
            
