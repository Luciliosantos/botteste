<?php
if (!file_exists('dadosBot.ini')){
    echo "ERRO: dadosBot.ini nao encontrado!\n";
    exit;
}

$ini = parse_ini_file('dadosBot.ini');
$token = trim($ini['token'] ?? '');
if (!$token) { echo "ERRO: Token vazio!\n"; exit; }

$api = "https://api.telegram.org/bot$token/";
$mp_token = "APP_USR-7527190269570273-090920-8e00f0eee8a23cb2fdd7f7d8db4a4dbf-226024458";
$admin = 7761133138;
$offset = 0;
$sessao = [];

$recargas = [
    'vivo'  => ['nome'=>'📱 VIVO',   'valores'=>[15,25,35,50,100]],
    'claro' => ['nome'=>'📱 CLARO',  'valores'=>[10,20,30,50,80]],
    'tim'   => ['nome'=>'📱 TIM',    'valores'=>[15,25,40,60,90]],
    'oi'    => ['nome'=>'📱 OI',     'valores'=>[10,20,35,50]]
];

function enviar($d){
    global $api;
    $ch = curl_init($api.'sendMessage');
    curl_setopt_array($ch, [
        CURLOPT_POST => 1,
        CURLOPT_POSTFIELDS => http_build_query($d),
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_TIMEOUT => 5
    ]);
    curl_exec($ch); curl_close($ch);
}

echo "✅ BOT CORRIGIDO ATIVO\n";

while(true){
    $ch = curl_init($api."getUpdates?offset=$offset&timeout=2");
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_TIMEOUT => 4
    ]);
    $resp = curl_exec($ch); curl_close($ch);
    
    $dados = json_decode($resp, true);
    if(!isset($dados['result'])){ usleep(150000); continue; }
    
    foreach($dados['result'] as $u){
        $offset = $u['update_id'] + 1;
        $cid = $txt = $cb = '';
        
        if(isset($u['message'])){
            $cid = $u['message']['chat']['id'];
            $txt = trim($u['message']['text'] ?? '');
        }
        if(isset($u['callback_query'])){
            $cb = $u['callback_query']['data'];
            $cid = $u['callback_query']['message']['chat']['id'];
            @file_get_contents($api."answerCallbackQuery?callback_query_id=".$u['callback_query']['id']."&text=OK");
        }
        if(!$cid) continue;

        // === MENU PRINCIPAL ===
        if($txt === '/start' || $cb === 'recarga_voltar'){
            $kb = [
                'inline_keyboard' => [
                    [['text'=>'🇧🇷 SSH GRÁTIS','callback_data'=>'/ssh']],
                    [['text'=>'💵 COMPRAR 30 DIAS','callback_data'=>'/pix']],
                    [['text'=>'🔋 RECARGA DE CELULAR','callback_data'=>'recarga_lista']],
                    [['text'=>'📲 BAIXAR APK','url'=>'https://www.terabox.com'],['text'=>'👤 CRIADOR','url'=>'https://t.me/lssilvae']],
                    [['text'=>'💰 REVENDEDOR','callback_data'=>'/revenda'],['text'=>'📋 MINHA CONTA','callback_data'=>'/minhaconta']]
                ]
            ];
            enviar(['chat_id'=>$cid,'text'=>"<b>✨ BEM-VINDO AO SISTEMA ✨</b>\nEscolha o que deseja fazer 👇",'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
            continue;
        }

        // === LISTA DE OPERADORAS ===
        if($cb === 'recarga_lista'){
            $kb = ['inline_keyboard' => []];
            foreach($recargas as $chave => $dados_op){
                $kb['inline_keyboard'][] = [['text'=>$dados_op['nome'],'callback_data'=>"op_$chave"]];
            }
            $kb['inline_keyboard'][] = [['text'=>'◀️ Voltar','callback_data'=>'recarga_voltar']];
            enviar(['chat_id'=>$cid,'text'=>"<b>🔋 RECARGA DE CELULAR</b>\nEscolha a operadora 👇",'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
            continue;
        }

        // === ESCOLHEU OPERADORA → MOSTRA VALORES ===
        if(str_starts_with($cb, 'op_')){
            $op = substr($cb, 3);
            if(!isset($recargas[$op])) continue;
            $sessao[$cid]['op'] = $op;
            
            $kb = ['inline_keyboard' => []];
            foreach($recargas[$op]['valores'] as $v){
                $kb['inline_keyboard'][] = [['text'=>"R$ ".number_format($v,2,',',''),'callback_data'=>"val_{$op}_{$v}"]];
            }
            $kb['inline_keyboard'][] = [['text'=>'◀️ Voltar','callback_data'=>'recarga_lista']];
            
            enviar(['chat_id'=>$cid,'text'=>"<b>{$recargas[$op]['nome']}</b>\nEscolha o valor 👇",'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
            continue;
        }

        // === ESCOLHEU VALOR → Pede NÚMERO ===
        if(str_starts_with($cb, 'val_')){
            $partes = explode('_', $cb);
            $op = $partes[1];
            $valor = (float)$partes[2];
            $sessao[$cid]['op'] = $op;
            $sessao[$cid]['valor'] = $valor;
            $sessao[$cid]['etapa'] = 'pedir_numero';
            
            enviar(['chat_id'=>$cid,'text'=>"✅ Valor escolhido: <b>R$ ".number_format($valor,2,',','')."</b>\nDigite o número com DDD (ex: 11988887777):",'parse_mode'=>'html']);
            continue;
        }

        // === RECEBEU NÚMERO → CONFIRMAÇÃO ===
        if(($sessao[$cid]['etapa'] ?? '') === 'pedir_numero' && $txt){
            $numero = preg_replace('/[^0-9]/', '', $txt);
            if(strlen($numero) < 10 || strlen($numero) > 11){
                enviar(['chat_id'=>$cid,'text'=>'❌ Número inválido! Digite com DDD, apenas números. Ex: 11988887777','parse_mode'=>'html']);
                continue;
            }
            $op = $sessao[$cid]['op'];
            $valor = $sessao[$cid]['valor'];
            $sessao[$cid]['numero'] = $numero;
            $sessao[$cid]['etapa'] = 'confirmar';
            
            $kb = [
                'inline_keyboard' => [
                    [['text'=>'✅ CONFIRMAR','callback_data'=>'finalizar']],
                    [['text'=>'❌ Cancelar','callback_data'=>'recarga_lista']]
                ]
            ];
            enviar(['chat_id'=>$cid,'text'=>"<b>📋 RESUMO DA RECARGA</b>\nOperadora: {$recargas[$op]['nome']}\nNúmero: <code>$numero</code>\nValor: <b>R$ ".number_format($valor,2,',','')."</b>\nConfirma?",'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
            continue;
        }

        // === FINALIZA → AVISA ADMIN ===
        if($cb === 'finalizar'){
            $op = $sessao[$cid]['op'];
            $valor = $sessao[$cid]['valor'];
            $numero = $sessao[$cid]['numero'];
            
            if($admin && $admin !== $cid){
                enviar(['chat_id'=>$admin,'text'=>"🔔 NOVA RECARGA SOLICITADA\n\nOperadora: {$recargas[$op]['nome']}\nNúmero: <code>$numero</code>\nValor: R$ ".number_format($valor,2,',','')."\nCliente ID: <code>$cid</code>",'parse_mode'=>'html']);
            }
            enviar(['chat_id'=>$cid,'text'=>'✅ <b>PEDIDO RECEBIDO!</b>\nEstamos processando sua recarga. Em breve será creditado! 💳','parse_mode'=>'html']);
            unset($sessao[$cid]);
            continue;
        }

        // === DEMAIS FUNÇÕES ===
        if($cb === '/ssh'){
            $usuario = substr(str_shuffle('ABCDEFGHIJKLMNOPQRSTUVWXYZ'), 0, 5);
            $senha = rand(11111, 99999);
            @chmod('gerarusuario.sh', 0755);
            if(file_exists('gerarusuario.sh')){
                exec("./gerarusuario.sh $usuario $senha 1 1");
            } else {
                exec("useradd -M -s /bin/false $usuario && echo \"$usuario:$senha\" | chpasswd");
            }
            enviar(['chat_id'=>$cid,'text'=>"✅ <b>CONTA SSH CRIADA!</b>\nUsuário: <code>$usuario</code>\nSenha: <code>$senha</code>\nValidade: 1 dia",'parse_mode'=>'html']);
            continue;
        }

        if($cb === '/pix'){
            enviar(['chat_id'=>$cid,'text'=>'⏳ Gerando PIX...','parse_mode'=>'html']);
            $pagamento = [
                "transaction_amount" => 20.00,
                "description" => "Acesso 30 Dias",
                "payment_method_id" => "pix",
                "payer" => ["email" => "cliente@bot.com", "first_name" => "Cliente", "last_name" => "Telegram"]
            ];
            $ch = curl_init("https://api.mercadopago.com/v1/payments");
            curl_setopt_array($ch, [
                CURLOPT_POST => 1,
                CURLOPT_POSTFIELDS => json_encode($pagamento),
                CURLOPT_HTTPHEADER => [
                    "Content-Type: application/json",
                    "Authorization: Bearer $mp_token"
                ],
                CURLOPT_RETURNTRANSFER => 1,
                CURLOPT_SSL_VERIFYPEER => 0,
                CURLOPT_TIMEOUT => 10
            ]);
            $resp_mp = curl_exec($ch); curl_close($ch);
            $dados_mp = json_decode($resp_mp, true);
            $pix_copia = $dados_mp['point_of_interaction']['transaction_data']['qr_code'] ?? '';
            $id_pag = $dados_mp['id'] ?? '';
            
            if($pix_copia && $id_pag){
                enviar(['chat_id'=>$cid,'text'=>"💵 <b>PIX GERADO!</b>\nCopie e pague:\n<code>$pix_copia</code>\nAguardando confirmação...",'parse_mode'=>'html']);
            } else {
                enviar(['chat_id'=>$cid,'text'=>'❌ Erro ao gerar PIX. Tente novamente.','parse_mode'=>'html']);
            }
            continue;
        }

        if($cb === '/revenda'){
            enviar(['chat_id'=>$cid,'text'=>'💰 <b>SEJA REVENDEDOR!</b>\nFale com @lssilvae','parse_mode'=>'html']);
            continue;
        }
        if($cb === '/minhaconta'){
            enviar(['chat_id'=>$cid,'text'=>'📋 <b>MINHA CONTA</b>\nEm breve disponível!','parse_mode'=>'html']);
            continue;
        }
    }
    usleep(150000);
}
