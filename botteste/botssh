// === FUNÇÕES AUXILIARES ===
function enviar($d){
    global $api;
    $ch = curl_init($api.'sendMessage');
    curl_setopt_array($ch, [CURLOPT_POST=>1, CURLOPT_POSTFIELDS=>http_build_query($d),
        CURLOPT_RETURNTRANSFER=>1, CURLOPT_SSL_VERIFYPEER=>0, CURLOPT_TIMEOUT=>10]);
    curl_exec($ch); curl_close($ch);
}

function editar_msg($d){
    global $api;
    $ch = curl_init($api.'editMessageText');
    curl_setopt_array($ch, [CURLOPT_POST=>1, CURLOPT_POSTFIELDS=>http_build_query($d),
        CURLOPT_RETURNTRANSFER=>1, CURLOPT_SSL_VERIFYPEER=>0, CURLOPT_TIMEOUT=>10]);
    curl_exec($ch); curl_close($ch);
}

function responder_clique($callback_id, $texto = "Processando..."){
    global $api;
    @file_get_contents($api."answerCallbackQuery?callback_query_id=$callback_id&text=".urlencode($texto));
}

function gerar_pix_mp($valor, $descricao){
    global $mp_token;
    $pagamento = [
        "transaction_amount" => $valor,
        "description" => $descricao,
        "payment_method_id" => "pix",
        "payer" => ["email" => "pagamento@bot.com", "first_name" => "Cliente", "last_name" => "Telegram"]
    ];
    $ch = curl_init("https://api.mercadopago.com/v1/payments");
    curl_setopt_array($ch, [CURLOPT_POST=>1, CURLOPT_POSTFIELDS=>json_encode($pagamento),
        CURLOPT_HTTPHEADER=>["Content-Type: application/json", "Authorization: Bearer $mp_token"],
        CURLOPT_RETURNTRANSFER=>1, CURLOPT_SSL_VERIFYPEER=>0, CURLOPT_TIMEOUT=>10]);
    $resp = curl_exec($ch); curl_close($ch);
    return json_decode($resp, true);
}

function verificar_pagamento($id_pag){
    global $mp_token, $api_mp;
    $ch = curl_init($api_mp.$id_pag);
    curl_setopt_array($ch, [CURLOPT_HTTPHEADER=>["Authorization: Bearer $mp_token"],
        CURLOPT_RETURNTRANSFER=>1, CURLOPT_SSL_VERIFYPEER=>0, CURLOPT_TIMEOUT=>8]);
    $resp = curl_exec($ch); curl_close($ch);
    if(!$resp) return false;
    $d = json_decode($resp, true);
    return ($d['status'] ?? '') === 'approved';
}

function pode_pedir_teste($chat_id){
    global $teste_gratis;
    $hoje = date('d/m/Y');
    return !isset($teste_gratis[$chat_id]) || $teste_gratis[$chat_id] !== $hoje;
}

function gerar_conta_ssh($dias_validade){
    $usuario = substr(str_shuffle('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'), 0, 8);
    $senha = substr(str_shuffle('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%&*'), 0, 12);
    
    if(file_exists('gerarusuario.sh')){
        @chmod('gerarusuario.sh', 0755);
        exec("./gerarusuario.sh $usuario $senha $dias_validade 1");
    } else {
        exec("useradd -M -s /bin/false $usuario 2>/dev/null");
        exec("echo \"$usuario:$senha\" | chpasswd");
    }
    return [$usuario, $senha];
}

echo "✅ BOT INICIADO — PIX + SSH AUTOMÁTICO ✅\n";

