// === FUNÇÃO UNIFICADA DE CHAMADA CURL ===
function requisitar_api($url, $dados = null, $metodo = 'POST'){
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_POST => ($metodo === 'POST'),
        CURLOPT_POSTFIELDS => $dados ? (is_array($dados) ? http_build_query($dados) : $dados) : null,
        CURLOPT_HTTPHEADER => is_array($dados) && isset($dados['_headers']) ? $dados['_headers'] : [],
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_TIMEOUT => 15
    ]);
    $resposta = curl_exec($ch);
    $erro = curl_error($ch);
    curl_close($ch);
    if ($erro) error_log("ERRO CURL: $url → $erro");
    return $resposta;
}

// === FUNÇÕES AUXILIARES ===
function responder_clique($callback_id, $texto = "OK"){
    global $api;
    if (!$callback_id) return false;
    $url = $api."answerCallbackQuery?callback_query_id=".urlencode($callback_id)."&text=".urlencode($texto);
    requisitar_api($url, null, 'GET');
    return true;
}

function enviar($d){
    global $api;
    return requisitar_api($api.'sendMessage', $d);
}

function editar_ou_enviar($cid, $mid, $texto, $parse = 'html'){
    global $api;
    // Tenta editar primeiro
    $resp = requisitar_api($api.'editMessageText', [
        'chat_id' => $cid,
        'message_id' => $mid,
        'text' => $texto,
        'parse_mode' => $parse
    ]);
    // Se editar falhar → ENVIA MENSAGEM NOVA (garante que aparece!)
    if (!$resp || strpos($resp, '"ok":false') !== false) {
        return requisitar_api($api.'sendMessage', [
            'chat_id' => $cid,
            'text' => $texto,
            'parse_mode' => $parse
        ]);
    }
    return $resp;
}

function gerar_pix_mp($valor, $descricao){
    global $mp_token;
    $pagamento = [
        "transaction_amount" => $valor,
        "description" => $descricao,
        "payment_method_id" => "pix",
        "payer" => ["email" => "pagamento@bot.com", "first_name" => "Cliente", "last_name" => "Telegram"]
    ];
    $dados = json_encode($pagamento);
    $url = "https://api.mercadopago.com/v1/payments";
    $resp = requisitar_api($url, [
        '_headers' => ["Content-Type: application/json", "Authorization: Bearer $mp_token"],
        'dados' => $dados
    ]);
    return json_decode($resp, true);
}

function verificar_pagamento($id_pag){
    global $mp_token, $api_mp;
    $url = $api_mp.$id_pag;
    $resp = requisitar_api($url, ['_headers' => ["Authorization: Bearer $mp_token"]], 'GET');
    if(!$resp) return false;
    $d = json_decode($resp, true);
    return ($d['status'] ?? '') === 'approved';
}

function pode_pedir_teste($chat_id){
    global $teste_gratis;
    $hoje = date('d/m/Y');
    return !isset($teste_gratis[$chat_id]) || $teste_gratis[$chat_id] !== $hoje;
}

function gerar_conta_ssh($dias_validade){
    $usuario = substr(str_shuffle('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'), 0, 8);
    $senha = substr(str_shuffle('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%&*'), 0, 12);
    
    if(file_exists('gerarusuario.sh')){
        @chmod('gerarusuario.sh', 0755);
        exec("./gerarusuario.sh $usuario $senha $dias_validade 1");
    } else {
        exec("useradd -M -s /bin/false $usuario 2>/dev/null");
        exec("echo \"$usuario:$senha\" | chpasswd");
    }
    return [$usuario, $senha];
}

