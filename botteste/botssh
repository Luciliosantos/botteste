                editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>"⛔ <b>Limite Atingido!</b>\n\nVocê já pediu um teste grátis hoje.\nTente novamente amanhã! ✅",'parse_mode'=>'html']);
