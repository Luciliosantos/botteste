            continue;
        }
        if(($sessao[$cid]['etapa'] ?? '') === 'pedir_numero' && $txt){
            $numero = preg_replace('/[^0-9]/', '', $txt);
            if(strlen($numero)<10 || strlen($numero)>11){
                enviar(['chat_id'=>$cid,'text'=>'❌ Inválido! Digite com DDD, só números.','parse_mode'=>'html']);
                continue;
            }
            extract($sessao[$cid]);
            $mp = gerar_pix_mp($valor, "Recarga {$recargas[$op]['nome']} - $numero");
            $id_pag = $mp['id'] ?? '';
            $pix_copia = $mp['point_of_interaction']['transaction_data']['qr_code'] ?? '';
            if(!$id_pag || !$pix_copia){
                enviar(['chat_id'=>$cid,'text'=>'❌ Erro ao gerar PIX. Tente novamente.','parse_mode'=>'html']);
                continue;
            }
            $pagamentos[$id_pag] = ['cid'=>$cid,'op'=>$op,'valor'=>$valor,'numero'=>$numero,'tipo'=>'recarga'];
            enviar(['chat_id'=>$cid,'text'=>"💳 <b>PAGAMENTO VIA PIX</b>\n\n📋 Operadora: {$recargas[$op]['nome']}\n💰 Valor: <b>R$ ".number_format($valor,2,',','')."</b>\n📱 Número: <code>$numero</code>\n\n📋 Copia e cola:\n<pre>$pix_copia</pre>\n⏳ Após pagar, a recarga pode demorar até 8 horas! ⏳",'parse_mode'=>'html']);
            unset($sessao[$cid]);
            continue;
        }
        if($cb === '/revenda'){
            responder_clique($callback_id);
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>'💰 <b>SEJA REVENDEDOR!</b>\nFale com @lssilvae','parse_mode'=>'html']);
            continue;
        }
        if($cb === '/minhaconta'){
            responder_clique($callback_id);
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>'📋 <b>MINHA CONTA</b>\nEm breve!','parse_mode'=>'html']);
            continue;
        }
    }
    usleep(50000);
}
