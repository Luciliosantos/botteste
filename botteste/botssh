            continue;
        }
        if(substr($cb, 0, 4) === 'val_'){
            responder_clique($callback_id);
            $partes = explode('_', $cb);
            if(count($partes) < 3) continue;
            list(,$op,$valor) = $partes;
            if(!isset($recargas[$op])) continue;
            $sessao[$cid] = ['op'=>$op,'valor'=>(float)$valor,'etapa'=>'pedir_numero'];
