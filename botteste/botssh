// === FUNÇÕES SIMPLES ===
function curl_post($url, $dados){
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_POST => 1,
        CURLOPT_POSTFIELDS => $dados,
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_TIMEOUT => 15
    ]);
    $r = curl_exec($ch);
    curl_close($ch);
    return $r;
}

function curl_get($url){
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_TIMEOUT => 15
    ]);
    $r = curl_exec($ch);
    curl_close($ch);
    return $r;
}

function responde_clique($cid, $mid, $callback_id, $texto){
    global $api;
    // Confirma o clique PRO Telegram
    curl_get($api."answerCallbackQuery?callback_query_id=".urlencode($callback_id)."&text=OK");
}

function gera_pix($valor, $desc, $token_mp){
    $dados = json_encode([
        "transaction_amount" => $valor,
        "description" => $desc,
        "payment_method_id" => "pix",
        "payer" => ["email"=>"pagamento@bot.com","first_name"=>"Cliente","last_name"=>"Telegram"]
    ]);
    $ch = curl_init("https://api.mercadopago.com/v1/payments");
    curl_setopt_array($ch, [
        CURLOPT_POST => 1,
        CURLOPT_POSTFIELDS => $dados,
        CURLOPT_HTTPHEADER => [
            "Content-Type: application/json",
            "Authorization: Bearer $token_mp"
        ],
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_TIMEOUT => 15
    ]);
    $r = curl_exec($ch);
    curl_close($ch);
    return json_decode($r, true);
}

function gera_conta($dias){
    $u = substr(str_shuffle('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'),0,8);
    $s = substr(str_shuffle('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%'),0,12);
    return [$u,$s];
}

