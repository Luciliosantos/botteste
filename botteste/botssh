// === FUNÇÃO CURL ===
function requisitar_api($url, $dados = null, $metodo = 'POST'){
    $ch = curl_init($url);
    $opts = [
        CURLOPT_POST => ($metodo === 'POST'),
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_TIMEOUT => 15
    ];
    if ($dados && $metodo === 'POST') {
        if (isset($dados['_headers'])) {
            $opts[CURLOPT_HTTPHEADER] = $dados['_headers'];
            $opts[CURLOPT_POSTFIELDS] = $dados['_body'] ?? '';
        } else {
            $opts[CURLOPT_POSTFIELDS] = http_build_query($dados);
        }
    }
    curl_setopt_array($ch, $opts);
    $resp = curl_exec($ch);
    $erro = curl_error($ch);
    curl_close($ch);
    if ($erro) error_log("ERRO: $url → $erro");
    return $resp;
}

// === CONFIRMA CLIQUE ===
function responder_clique($callback_id, $texto = "OK"){
    global $api;
    if (!$callback_id) return;
    requisitar_api($api."answerCallbackQuery?callback_query_id=".urlencode($callback_id)."&text=".urlencode($texto), null, 'GET');
}

// === EDITAR OU ENVIAR — COM BOTÕES! ===
function editar_ou_enviar($cid, $mid, $texto, $parse = 'html', $botoes = null){
    global $api;
    $dados = [
        'chat_id' => $cid,
        'message_id' => $mid,
        'text' => $texto,
        'parse_mode' => $parse
    ];
    if ($botoes) $dados['reply_markup'] = $botoes;
    
    $resp = requisitar_api($api.'editMessageText', $dados);
    
    if (!$resp || strpos($resp, '"ok":false') !== false) {
        $envio = ['chat_id' => $cid, 'text' => $texto, 'parse_mode' => $parse];
        if ($botoes) $envio['reply_markup'] = $botoes;
        requisitar_api($api.'sendMessage', $envio);
    }
}

function enviar($d){
    global $api;
    requisitar_api($api.'sendMessage', $d);
}

function gerar_pix_mp($valor, $descricao){
    global $mp_token;
    $pagamento = [
        "transaction_amount" => $valor,
        "description" => $descricao,
        "payment_method_id" => "pix",
        "payer" => ["email" => "pagamento@bot.com", "first_name" => "Cliente", "last_name" => "Telegram"]
    ];
    $json = json_encode($pagamento);
    $resp = requisitar_api("https://api.mercadopago.com/v1/payments", [
        '_headers' => ["Content-Type: application/json", "Authorization: Bearer $mp_token"],
        '_body' => $json
    ]);
    return json_decode($resp, true);
}

function verificar_pagamento($id_pag){
    global $mp_token, $api_mp;
    $resp = requisitar_api($api_mp.$id_pag, ['_headers' => ["Authorization: Bearer $mp_token"]], 'GET');
    if(!$resp) return false;
    $d = json_decode($resp, true);
    return ($d['status'] ?? '') === 'approved';
}

function pode_pedir_teste($cid){
