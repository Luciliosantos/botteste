    $resp = curl_exec($ch); curl_close($ch);
    if(!$resp || !($dados = json_decode($resp, true)) || !isset($dados['result'])){
        usleep(50000); continue;
    }
    
    foreach($dados['result'] as $u){
        $offset = $u['update_id'] + 1;
        $cid = $txt = $cb = $mid = $callback_id = '';
        
        if(isset($u['message'])){
            $cid = $u['message']['chat']['id'];
            $txt = trim($u['message']['text'] ?? '');
            $mid = $u['message']['message_id'];
        }
        if(isset($u['callback_query'])){
            $cb = $u['callback_query']['data'];
            $cid = $u['callback_query']['message']['chat']['id'];
            $mid = $u['callback_query']['message']['message_id'];
            $callback_id = $u['callback_query']['id'];
        }
        if(!$cid) continue;

        // === MENU PRINCIPAL ===
        if($txt === '/start' || $cb === 'voltar_inicio'){
            if($callback_id) responder_clique($callback_id);
            $kb = [
                'inline_keyboard' => [
                    [['text'=>'🎁 TESTE GRÁTIS','callback_data'=>'/teste']],
                    [['text'=>'🛒 COMPRAR SSH','callback_data'=>'comprar_ssh']],
                    [['text'=>'🔋 RECARGA DE CELULAR','callback_data'=>'recarga_lista']],
                    [['text'=>'📲 BAIXAR APK','url'=>'https://www.terabox.com'],['text'=>'👤 CRIADOR','url'=>'https://t.me/lssilvae']],
                    [['text'=>'💰 REVENDEDOR','callback_data'=>'/revenda'],['text'=>'📋 MINHA CONTA','callback_data'=>'/minhaconta']]
                ]
            ];
            
            $texto = "<b>✨ TECNET 5G ✨</b>\n\nSeja muito bem-vindo(a)! 🚀\n\nCompre seus acessos SSH de forma rápida, segura e totalmente automática.\n\n✅ Pagamento via PIX\n✅ Entrega automática\n✅ Suporte 24 horas\n\nEscolha uma opção abaixo 👇";
            
            if($cb) editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>$texto,'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
