                'chat_id' => $cid,
                'message_id' => $mid,
                'text' => "⏳ Gerando PIX — Plano de {$pl['dias']} dias...\nAguarde um instante ⏱️",
                'parse_mode' => 'html'
            ]);
            
            // ✅ Agora gera o PIX
            $mp = gerar_pix_mp($pl['valor'], "SSH {$pl['dias']} Dias — TecNet 5G");
            $id_pag = $mp['id'] ?? '';
            $pix_copia = $mp['point_of_interaction']['transaction_data']['qr_code'] ?? '';
            
            if(!$id_pag || !$pix_copia){
