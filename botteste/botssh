<?php
error_reporting(E_ALL);
ini_set('display_errors', 1);
set_time_limit(0);
ignore_user_abort(true);

// === CONFIGURAÇÃO ===
$ini = parse_ini_file('dadosBot.ini', true);
$token = trim($ini['token'] ?? '');
$mp_token = trim($ini['mp_token'] ?? '');

if (!$token || !$mp_token) {
    die("❌ Verifique dadosBot.ini!");
}

$api = "https://api.telegram.org/bot$token/";
$pagamentos = [];

// === PLANOS ===
$planos = [
    1  => ['dias' => 1,  'valor' => 1.00,  'nome' => '🟢 1 Dia — R$ 1,00'],
    5  => ['dias' => 5,  'valor' => 4.00,  'nome' => '🟢 5 Dias — R$ 4,00'],
    10 => ['dias' => 10, 'valor' => 10.00, 'nome' => '🟡 10 Dias — R$ 10,00'],
    15 => ['dias' => 15, 'valor' => 14.00, 'nome' => '🟠 15 Dias — R$ 14,00'],
    30 => ['dias' => 30, 'valor' => 20.00, 'nome' => '🔵 30 Dias — R$ 20,00']
];

// === FUNÇÃO ===
function req($url, $post = '') {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_POST => !!$post,
        CURLOPT_POSTFIELDS => $post,
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_TIMEOUT => 30
    ]);
    $r = curl_exec($ch);
    curl_close($ch);
    return $r;
}

// ✅ CONFIRMA CLIQUE — SEM ISSO NÃO FUNCIONA!
function ok_clique($id, $msg = "OK") {
    global $api;
    if (!$id) return;
    req($api."answerCallbackQuery?callback_query_id=".urlencode($id)."&text=".urlencode($msg));
}

function enviar($d) {
    global $api;
    req($api."sendMessage", http_build_query($d));
}

function gerar_pix($valor, $desc) {
    global $mp_token;
    $json = json_encode([
        "transaction_amount" => $valor,
        "description" => $desc,
        "payment_method_id" => "pix",
        "payer" => ["email"=>"a@b.com","first_name"=>"Cliente","last_name"=>"Telegram"]
    ]);
    $r = req("https://api.mercadopago.com/v1/payments", $json, [
        "Content-Type: application/json",
        "Authorization: Bearer $mp_token"
    ]);
    return json_decode($r, true);
}

// === INICIO ===
req($api."deleteWebhook");
echo "✅ BOT RODANDO — CLIQUES VÃO FUNCIONAR!\n";

$offset = 0;
while(true) {
    $res = req($api."getUpdates?offset=$offset&timeout=5");
    $d = json_decode($res, true);
    if (!isset($d['result'])) { usleep(50000); continue; }
    
    foreach ($d['result'] as $u) {
        $offset = $u['update_id'] + 1;
        $cid = $txt = $cb = $cbid = '';
        
        if (isset($u['message'])) {
            $cid = $u['message']['chat']['id'];
            $txt = trim($u['message']['text'] ?? '');
        }
        if (isset($u['callback_query'])) {
            $cb = $u['callback_query']['data'];
            $cid = $u['callback_query']['message']['chat']['id'];
            $cbid = $u['callback_query']['id'];
            echo "👉 CLIQUE: $cb\n"; // ← VAI APARECER NO TERMINAL!
        }
        if (!$cid) continue;

        // === /START ===
        if ($txt === '/start' || $cb === 'voltar_inicio') {
            if ($cbid) ok_clique($cbid);
            $b = json_encode(['inline_keyboard' => [
                [['text'=>'🛒 COMPRAR SSH','callback_data'=>'comprar_ssh']],
                [['text'=>'◀️ Voltar','callback_data'=>'voltar_inicio']]
            ]]);
            enviar(['chat_id'=>$cid,'text'=>"<b>Escolha:</b>",'parse_mode'=>'html','reply_markup'=>$b]);
            continue;
        }

        // === ABRIR PLANOS — AQUI ESTAVA O ERRO! ===
        if ($cb === 'comprar_ssh') {
            ok_clique($cbid, "Abrindo..."); // ✅ CONFIRMA PRIMEIRO!
            echo "✅ Abrindo planos para $cid\n";
            
            $botoes = ['inline_keyboard' => []];
            foreach ($planos as $k => $p) {
                $botoes['inline_keyboard'][] = [['text'=>$p['nome'],'callback_data'=>"plano_$k"]];
            }
            $botoes['inline_keyboard'][] = [['text'=>'◀️ Voltar','callback_data'=>'voltar_inicio']];
            
            enviar([
                'chat_id' => $cid,
                'text' => "🛒 <b>ESCOLHA SEU PLANO:</b>",
                'parse_mode' => 'html',
                'reply_markup' => json_encode($botoes)
            ]);
            continue;
        }

        // === GERAR PIX ===
        if (substr($cb, 0, 7) === 'plano_') {
            $k = (int)substr($cb, 7);
            if (!isset($planos[$k])) { ok_clique($cbid,"Inválido!"); continue; }
            
            ok_clique($cbid, "Gerando PIX..."); // ✅ CONFIRMA!
            $pl = $planos[$k];
            
            enviar(['chat_id'=>$cid,'text'=>"⏳ Gerando PIX...",'parse_mode'=>'html']);
            
            $mp = gerar_pix($pl['valor'], "SSH {$pl['dias']} Dias");
            $pix = $mp['point_of_interaction']['transaction_data']['qr_code'] ?? '';
            
            if ($pix) {
                enviar(['chat_id'=>$cid,'text'=>"💳 PIX:\n<pre>$pix</pre>",'parse_mode'=>'html']);
            } else {
                enviar(['chat_id'=>$cid,'text'=>"❌ Erro. Tente novamente.",'parse_mode'=>'html']);
            }
            continue;
        }
    }
    usleep(10000);
}
