                'message_id' => $mid,
                'text' => "💳 <b>PAGAMENTO VIA PIX</b>\n\n📋 Plano: <b>{$pl['dias']} Dias</b>\n💰 Valor: <b>R$ ".number_format($pl['valor'],2,',','')."</b>\n\n📋 <b>Copia e cola:</b>\n<pre>$pix_copia</pre>\n\n⏳ Após pagar, sua conta será enviada automaticamente! ✅",
                'parse_mode' => 'html'
            ]);
