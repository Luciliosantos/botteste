<?php
error_reporting(0);
ini_set('display_errors', 0);
set_time_limit(0);

if (!file_exists('dadosBot.ini')){
    echo "❌ ERRO: dadosBot.ini NAO ENCONTRADO!\n";
    exit;
}

$ini = parse_ini_file('dadosBot.ini', true);
$token = trim($ini['token'] ?? '');
$mp_token = trim($ini['mp_token'] ?? '');

if (!$token) { echo "❌ ERRO: Token vazio!\n"; exit; }
if (!$mp_token) { echo "❌ ERRO: mp_token vazio!\n"; exit; }

$api = "https://api.telegram.org/bot$token/";
$api_mp = "https://api.mercadopago.com/v1/payments/";
$admin = 7761133138;
$offset = 0;
$sessao = [];
$pagamentos = [];

$recargas = [
    'vivo'  => ['nome'=>'📱 VIVO',   'valores'=>[15,25,35,50,100]],
    'claro' => ['nome'=>'📱 CLARO',  'valores'=>[10,20,30,50,80]],
    'tim'   => ['nome'=>'📱 TIM',    'valores'=>[15,25,40,60,90]],
    'oi'    => ['nome'=>'📱 OI',     'valores'=>[10,20,35,50]]
];

function enviar($d){
    global $api;
    $ch = curl_init($api.'sendMessage');
    curl_setopt_array($ch, [
        CURLOPT_POST => 1,
        CURLOPT_POSTFIELDS => http_build_query($d),
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_CONNECTTIMEOUT => 5,
        CURLOPT_TIMEOUT => 10
    ]);
    curl_exec($ch); curl_close($ch);
}

function editar_msg($d){
    global $api;
    $ch = curl_init($api.'editMessageText');
    curl_setopt_array($ch, [
        CURLOPT_POST => 1,
        CURLOPT_POSTFIELDS => http_build_query($d),
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_CONNECTTIMEOUT => 5,
        CURLOPT_TIMEOUT => 10
    ]);
    curl_exec($ch); curl_close($ch);
}

function gerar_pix_mp($valor, $descricao){
    global $mp_token;
    $pagamento = [
        "transaction_amount" => $valor,
        "description" => $descricao,
        "payment_method_id" => "pix",
        "payer" => ["email" => "pagamento@bot.com", "first_name" => "Cliente", "last_name" => "Telegram"]
    ];
    $ch = curl_init("https://api.mercadopago.com/v1/payments");
    curl_setopt_array($ch, [
        CURLOPT_POST => 1,
        CURLOPT_POSTFIELDS => json_encode($pagamento),
        CURLOPT_HTTPHEADER => ["Content-Type: application/json", "Authorization: Bearer $mp_token"],
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_CONNECTTIMEOUT => 5,
        CURLOPT_TIMEOUT => 15
    ]);
    $resp = curl_exec($ch); curl_close($ch);
    return json_decode($resp, true);
}

function verificar_pagamento($id_pag){
    global $mp_token, $api_mp;
    $ch = curl_init($api_mp.$id_pag);
    curl_setopt_array($ch, [
        CURLOPT_HTTPHEADER => ["Authorization: Bearer $mp_token"],
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_CONNECTTIMEOUT => 5,
        CURLOPT_TIMEOUT => 10
    ]);
    $resp = curl_exec($ch); curl_close($ch);
    if(!$resp) return false;
    $d = json_decode($resp, true);
    return ($d['status'] ?? '') === 'approved';
}

echo "✅ BOT INICIADO — PIX AUTOMÁTICO\n";

while(true){
    // === MONITORA PAGAMENTOS — A CADA 10s ===
    foreach($pagamentos as $id_pag => $pedido){
        if(verificar_pagamento($id_pag)){
            $cid = $pedido['cid'];
            $op = $pedido['op'];
            $valor = $pedido['valor'];
            $numero = $pedido['numero'];
            $nome_op = $recargas[$op]['nome'];

            enviar([
                'chat_id' => $cid,
                'text' => "✅ <b>PAGAMENTO CONFIRMADO!</b>\n\nRecebemos seu pagamento! 🎉\nProcessando recarga... ⏳\nNúmero: <code>$numero</code>\n\nObrigado! 💜",
                'parse_mode' => 'html'
            ]);

            if($admin){
                enviar([
                    'chat_id' => $admin,
                    'text' => "🔔 ✅ PAGAMENTO CONFIRMADO — FAZER RECARGA\n\n📋 DADOS:\n🔹 Operadora: <b>$nome_op</b>\n🔹 Valor: R$ ".number_format($valor,2,',','')."\n🔹 Número: <code>$numero</code>\n🔹 Cliente ID: <code>$cid</code>\n\n👉 FAZER A RECARGA AGORA! 💳",
                    'parse_mode' => 'html'
                ]);
            }
            unset($pagamentos[$id_pag]);
        }
    }

    // === RECEBE MENSAGENS ===
    $ch = curl_init($api."getUpdates?offset=$offset&timeout=5");
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => 1,
        CURLOPT_SSL_VERIFYPEER => 0,
        CURLOPT_CONNECTTIMEOUT => 5,
        CURLOPT_TIMEOUT => 10
    ]);
    $resp = curl_exec($ch); curl_close($ch);
    
    if(!$resp){
        usleep(100000); // 0,1s
        continue;
    }
    
    $dados = json_decode($resp, true);
    if(!isset($dados['result']) || !is_array($dados['result'])){
        usleep(100000);
        continue;
    }
    
    foreach($dados['result'] as $u){
        $offset = $u['update_id'] + 1;
        $cid = $txt = $cb = $mid = '';
        
        if(isset($u['message'])){
            $cid = $u['message']['chat']['id'];
            $txt = trim($u['message']['text'] ?? '');
            $mid = $u['message']['message_id'];
        }
        if(isset($u['callback_query'])){
            $cb = $u['callback_query']['data'];
            $cid = $u['callback_query']['message']['chat']['id'];
            $mid = $u['callback_query']['message']['message_id'];
            @file_get_contents($api."answerCallbackQuery?callback_query_id=".$u['callback_query']['id']."&text=Aguardando pagamento...");
        }
        if(!$cid) continue;

        // === MENU PRINCIPAL ===
        if($txt === '/start' || $cb === 'recarga_voltar'){
            $kb = [
                'inline_keyboard' => [
                    [['text'=>'🇧🇷 SSH GRÁTIS','callback_data'=>'/ssh']],
                    [['text'=>'💵 COMPRAR 30 DIAS','callback_data'=>'/pix']],
                    [['text'=>'🔋 RECARGA DE CELULAR','callback_data'=>'recarga_lista']],
                    [['text'=>'📲 BAIXAR APK','url'=>'https://www.terabox.com'],['text'=>'👤 CRIADOR','url'=>'https://t.me/lssilvae']],
                    [['text'=>'💰 REVENDEDOR','callback_data'=>'/revenda'],['text'=>'📋 MINHA CONTA','callback_data'=>'/minhaconta']]
                ]
            ];
            if($cb){
                editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>"<b>✨ BEM-VINDO AO SISTEMA ✨</b>\nEscolha o que deseja fazer 👇",'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
            } else {
                enviar(['chat_id'=>$cid,'text'=>"<b>✨ BEM-VINDO AO SISTEMA ✨</b>\nEscolha o que deseja fazer 👇",'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
            }
            continue;
        }

        // === LISTA DE OPERADORAS ===
        if($cb === 'recarga_lista'){
            $kb = ['inline_keyboard' => []];
            foreach($recargas as $chave => $dados_op){
                $kb['inline_keyboard'][] = [['text'=>$dados_op['nome'],'callback_data'=>"op_$chave"]];
            }
            $kb['inline_keyboard'][] = [['text'=>'◀️ Voltar','callback_data'=>'recarga_voltar']];
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>"<b>🔋 RECARGA DE CELULAR</b>\nEscolha a operadora 👇",'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
            continue;
        }

        // === ESCOLHEU OPERADORA → VALORES ===
        if(substr($cb, 0, 3) === 'op_'){
            $op = substr($cb, 3);
            if(!isset($recargas[$op])){
                enviar(['chat_id'=>$cid,'text'=>'❌ Operadora inválida!','parse_mode'=>'html']);
                continue;
            }
            $sessao[$cid]['op'] = $op;
            
            $kb = ['inline_keyboard' => []];
            foreach($recargas[$op]['valores'] as $v){
                $kb['inline_keyboard'][] = [['text'=>"R$ ".number_format($v,2,',',''),'callback_data'=>"val_{$op}_{$v}"]];
            }
            $kb['inline_keyboard'][] = [['text'=>'◀️ Voltar','callback_data'=>'recarga_lista']];
            
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>"<b>{$recargas[$op]['nome']}</b>\nEscolha o valor 👇",'parse_mode'=>'html','reply_markup'=>json_encode($kb)]);
            continue;
        }

        // === ESCOLHEU VALOR → Pede NÚMERO ===
        if(substr($cb, 0, 4) === 'val_'){
            $partes = explode('_', $cb);
            if(count($partes) < 3) continue;
            $op = $partes[1];
            $valor = (float)$partes[2];
            if(!isset($recargas[$op])) continue;
            
            $sessao[$cid]['op'] = $op;
            $sessao[$cid]['valor'] = $valor;
            $sessao[$cid]['etapa'] = 'pedir_numero';
            
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>"✅ Valor: <b>R$ ".number_format($valor,2,',','')."</b>\nDigite o número com DDD (ex: 11988887777):",'parse_mode'=>'html']);
            continue;
        }

        // === NÚMERO RECEBIDO → GERA PIX ===
        if(($sessao[$cid]['etapa'] ?? '') === 'pedir_numero' && $txt){
            $numero = preg_replace('/[^0-9]/', '', $txt);
            if(strlen($numero) < 10 || strlen($numero) > 11){
                enviar(['chat_id'=>$cid,'text'=>'❌ Inválido! Digite com DDD, só números. Ex: 11988887777','parse_mode'=>'html']);
                continue;
            }
            $op = $sessao[$cid]['op'];
            $valor = $sessao[$cid]['valor'];
            
            $mp = gerar_pix_mp($valor, "Recarga {$recargas[$op]['nome']} - $numero");
            $id_pag = $mp['id'] ?? '';
            $pix_copia = $mp['point_of_interaction']['transaction_data']['qr_code'] ?? '';
            
            if(!$id_pag || !$pix_copia){
                enviar(['chat_id'=>$cid,'text'=>'❌ Erro ao gerar PIX. Tente novamente.','parse_mode'=>'html']);
                continue;
            }
            
            $pagamentos[$id_pag] = [
                'cid' => $cid,
                'op' => $op,
                'valor' => $valor,
                'numero' => $numero
            ];
            
            enviar([
                'chat_id' => $cid,
                'text' => "💳 <b>PAGAMENTO VIA PIX</b>\n\n📋 Operadora: {$recargas[$op]['nome']}\n💰 Valor: <b>R$ ".number_format($valor,2,',','')."</b>\n📱 Número: <code>$numero</code>\n\n📋 <b>COPIA E COLA:</b>\n<pre>$pix_copia</pre>\n\n⏳ Após pagar, confirma automaticamente!\nNão precisa avisar ✅",
                'parse_mode' => 'html'
            ]);
            
            unset($sessao[$cid]);
            continue;
        }

        // === SSH ===
        if($cb === '/ssh'){
            $usuario = substr(str_shuffle('ABCDEFGHIJKLMNOPQRSTUVWXYZ'), 0, 5);
            $senha = rand(11111, 99999);
            @chmod('gerarusuario.sh', 0755);
            if(file_exists('gerarusuario.sh')){
                exec("./gerarusuario.sh $usuario $senha 1 1");
            } else {
                exec("useradd -M -s /bin/false $usuario && echo \"$usuario:$senha\" | chpasswd");
            }
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>"✅ <b>CONTA CRIADA!</b>\nUsuário: <code>$usuario</code>\nSenha: <code>$senha</code>\nValidade: 1 dia",'parse_mode'=>'html']);
            continue;
        }

        // === PIX 30 DIAS ===
        if($cb === '/pix'){
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>'⏳ Gerando PIX...','parse_mode'=>'html']);
            $pagamento = [
                "transaction_amount" => 20.00,
                "description" => "Acesso 30 Dias",
                "payment_method_id" => "pix",
                "payer" => ["email" => "cliente@bot.com", "first_name" => "Cliente", "last_name" => "Telegram"]
            ];
            $ch = curl_init("https://api.mercadopago.com/v1/payments");
            curl_setopt_array($ch, [
                CURLOPT_POST => 1,
                CURLOPT_POSTFIELDS => json_encode($pagamento),
                CURLOPT_HTTPHEADER => ["Content-Type: application/json", "Authorization: Bearer $mp_token"],
                CURLOPT_RETURNTRANSFER => 1,
                CURLOPT_SSL_VERIFYPEER => 0,
                CURLOPT_TIMEOUT => 10
            ]);
            $resp_mp = curl_exec($ch); curl_close($ch);
            $dados_mp = json_decode($resp_mp, true);
            $pix_copia = $dados_mp['point_of_interaction']['transaction_data']['qr_code'] ?? '';
            $id_pag = $dados_mp['id'] ?? '';
            
            if($pix_copia && $id_pag){
                editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>"💵 <b>PIX GERADO!</b>\nCopie e pague:\n<code>$pix_copia</code>",'parse_mode'=>'html']);
            } else {
                editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>'❌ Erro ao gerar PIX','parse_mode'=>'html']);
            }
            continue;
        }

        if($cb === '/revenda'){
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>'💰 <b>SEJA REVENDEDOR!</b>\nFale com @lssilvae','parse_mode'=>'html']);
            continue;
        }
        if($cb === '/minhaconta'){
            editar_msg(['chat_id'=>$cid,'message_id'=>$mid,'text'=>'📋 <b>MINHA CONTA</b>\nEm breve!','parse_mode'=>'html']);
            continue;
        }
    }
    usleep(100000); // 0,1s — responde rápido
}
